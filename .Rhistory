geo <- fromJSON("shapefiles/Merged_Shapes/Merged_Shapes2.geojson")
str(geo)
library(sf)
library(dplyr)
# Extract features
features <- geo$features
# Convert geometries to sfc objects
geoms <- st_sfc(lapply(features$geometry$coordinates, function(coords, type) {
if (type[1] == "MultiPolygon") {
st_multipolygon(coords)
} else if (type[1] == "Polygon") {
st_polygon(coords)
} else {
stop("Unsupported geometry type: ", type[1])
}
}, type = features$geometry$type))
library(sf)
convert_to_sfc <- function(coords_list, geom_type) {
lapply(seq_along(coords_list), function(i) {
coords <- coords_list[[i]]
type <- geom_type[i]
if (type == "Polygon") {
# Ensure single polygon is a list of matrices
if (is.matrix(coords[[1]])) {
coords <- list(coords)  # wrap matrix in a list
}
st_polygon(coords)
} else if (type == "MultiPolygon") {
# Ensure each element is a polygon (list of matrices)
coords <- lapply(coords, function(poly) {
if (is.matrix(poly[[1]])) poly else poly
})
st_multipolygon(coords)
} else {
stop("Unsupported geometry type: ", type)
}
})
}
# Apply
geoms <- st_sfc(convert_to_sfc(features$geometry$coordinates, features$geometry$type))
library(sf)
# Helper: ensure proper structure for st_multipolygon
normalize_coords <- function(coords) {
# Each feature may be nested differently
if (all(sapply(coords, is.numeric))) {
# Single ring polygon → wrap in list of matrices
list(matrix(unlist(coords), ncol = 2, byrow = TRUE))
} else {
# Already a list of polygons
lapply(coords, function(ring) {
if (is.matrix(ring)) ring else matrix(unlist(ring), ncol = 2, byrow = TRUE)
})
}
}
# Convert geometries
geoms <- st_sfc(
lapply(seq_along(features$geometry$coordinates), function(i) {
type <- features$geometry$type[i]
coords <- features$geometry$coordinates[[i]]
if (type == "Polygon") {
st_polygon(normalize_coords(coords))
} else if (type == "MultiPolygon") {
st_multipolygon(lapply(coords, normalize_coords))
} else {
stop("Unsupported geometry type: ", type)
}
})
)
library(jsonlite)
geo <- fromJSON("shapefiles/Merged_Shapes/Merged_Shapes2.geojson")
features <- geo$features
library(sf)
# Close a ring if first != last point
close_ring <- function(mat) {
if (!all(mat[1, ] == mat[nrow(mat), ])) {
mat <- rbind(mat, mat[1, ])
}
mat
}
# Normalize coordinates: ensures proper matrix/list structure
normalize_coords <- function(coords) {
lapply(coords, function(ring) {
mat <- if (is.matrix(ring)) ring else matrix(unlist(ring), ncol = 2, byrow = TRUE)
close_ring(mat)
})
}
geoms <- st_sfc(
lapply(seq_along(features$geometry$coordinates), function(i) {
type <- features$geometry$type[i]
coords <- features$geometry$coordinates[[i]]
if (type == "Polygon") {
st_polygon(normalize_coords(coords))
} else if (type == "MultiPolygon") {
# Each polygon in multipolygon is normalized
st_multipolygon(lapply(coords, normalize_coords))
} else {
stop("Unsupported geometry type: ", type)
}
})
)
region_map <- st_sf(features$properties, geometry = geoms)
print(region_map)
plot(region_map["CONTINENT"])
